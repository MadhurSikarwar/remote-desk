{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Desk",
  "version": "0.1.0",
  "identifier": "dev.remotedesk.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Remote Desk",
        "width": 920,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Remote desktop that asks the person at the shared computer every time",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
